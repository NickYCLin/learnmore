@model EditLyricsViewModel

@{
    ViewData["Title"] = "歌詞編輯";
    ViewData["LayoutContainerClass"] = "container-fluid";
}

<style>
    .lyrics-editor-shell { display: grid; grid-template-columns: minmax(240px, 1fr) minmax(0, 2fr); gap: 1.25rem; align-items: start; }
    .lyrics-editor-video-pane, .lyrics-editor-list-pane { min-width: 0; }
    .video-wrapper { width: 100%; aspect-ratio: 16 / 9; background: var(--video-bg); }
    #songPlayer { width: 100%; height: 100%; display: block; }
    .lyrics-editor-list-pane { max-height: 75vh; overflow: auto; border: 1px solid var(--border-color); }
    .lyrics-editor-toolbar { position: sticky; top: 0; z-index: 2; display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; padding: .75rem; background: var(--bg-secondary); color: var(--text-primary); border-bottom: 1px solid var(--border-color); }
    .lyrics-editor-toolbar h3 { font-size: 1.1rem; margin: 0; }
    #markingProgress { margin: 0 auto 0 0; color: var(--text-secondary); }
    .lyrics-container { display: flex; flex-direction: column; }
    .lyrics-card { display: grid; grid-template-columns: 4rem 6rem repeat(3, minmax(0, 1fr)); gap: .5rem; padding: .6rem; border-bottom: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); }
    .lyrics-row { display: flex; flex-direction: column; min-width: 0; gap: .2rem; }
    .lyrics-row label { font-size: .8rem; margin: 0; color: var(--text-secondary); }
    .lyrics-row input { width: 100%; min-width: 0; min-height: 2.5rem; padding: .35rem; border: 1px solid var(--border-hover); border-radius: .25rem; background: var(--bg-primary); color: var(--text-primary); }
    .lyrics-row input::placeholder { color: var(--text-secondary); opacity: 1; }
    .lyrics-row input:focus-visible, .lyrics-editor-toolbar button:focus-visible, .lyrics-card button:focus-visible { outline: 2px solid var(--primary-color); outline-offset: 2px; }
    .lyrics-row input[aria-invalid="true"] { border-color: var(--danger-color, #b91c1c); }
    .lyrics-editor-toolbar button:disabled { opacity: 1; color: var(--text-secondary); background: var(--bg-tertiary); border-color: var(--border-hover); cursor: not-allowed; }
    .lyrics-row-actions { display: flex; flex-direction: column; gap: .25rem; align-items: start; }
    .drag-handle { cursor: grab; }
    .dragging { opacity: .6; outline: 2px dashed var(--primary-color); }
    .lyrics-card.marked { border-inline-start: 4px solid var(--primary-color); background: var(--bg-secondary); }
    .marked-label { grid-column: 1 / -1; color: var(--text-primary); font-size: .8rem; }
    #lyricsSaveStatus { flex-basis: 100%; margin: 0; color: var(--text-primary); }
    @@media (max-width: 991.98px) {
        .lyrics-editor-shell { grid-template-columns: minmax(0, 1fr); }
        .lyrics-editor-list-pane { max-height: none; overflow: visible; }
        .lyrics-card { grid-template-columns: 4rem 6rem minmax(0, 1fr); }
        .lyrics-row:nth-last-child(-n+2) { grid-column: 3; }
        .lyrics-editor-toolbar button { min-height: 44px; }
    }
    @@media (max-width: 480px) {
        .lyrics-card { grid-template-columns: 3.5rem minmax(0, 1fr); }
        .lyrics-row, .lyrics-row:nth-last-child(-n+2) { grid-column: 2; }
        .lyrics-row-actions { grid-column: 1; grid-row: 1 / span 4; }
    }
</style>

<h2>歌詞編輯 - @Model.MNmae</h2>
<partial name="_HighAccuracyStatusSummary" model='new HighAccuracyStatusSummaryViewModel
{
    Status = Model.HighAccuracyStatus,
    ReasonText = Model.HighAccuracyStatusReason,
    BadgeTitle = Model.HighAccuracyStatusReason,
    ContainerCssClass = "alert alert-light border d-flex flex-column gap-1",
    ReasonCssClass = "text-muted"
}' />
<input type="hidden" id="songUid" value="@Model.SongUid" />

<main class="flex-container lyrics-editor-shell">
    <div class="lyrics-editor-video-pane">
        <div class="video-wrapper">
            <video id="songPlayer" controls>
                <source id="videoSource" src="@Model.YoutubeVideoUrl" type="video/mp4">
                您的瀏覽器不支援影片播放。
            </video>
        </div>
    </div>
    <div class="lyrics-editor-list-pane">
        <div class="lyrics-editor-toolbar" role="region" aria-label="歌詞編輯工具列">
            <h3>全部歌詞</h3>
            <p id="markingProgress">標記進度：0 / @Model.Lyrics.Count</p>
                <button type="button" id="undoMarkTimeBtn" class="btn btn-warning">返回上一個標記</button>
                <button type="button" id="markTimeBtn" class="btn btn-success">標記時間</button>
            <button type="button" id="saveLyricsBtn" class="btn btn-primary">存檔</button>
            <p id="lyricsSaveStatus" role="status" aria-live="polite"></p>
        </div>
        <div class="lyrics-container">
            @for (int i = 0; i < Model.Lyrics.Count; i++)
            {
                <div class="lyrics-card draggable" data-id="@Model.Lyrics[i].LyricID">
                    <div class="lyrics-row-actions">
                        <span class="drag-handle">☰</span>
                        <button type="button" class="btn btn-danger delete-btn" data-id="@Model.Lyrics[i].LyricID">刪除</button>
                    </div>
                    <div class="lyrics-row">
                        <label for="lyric-time-@i">時間戳記</label>
                        <input id="lyric-time-@i" type="number" step="0.1" name="lyrics[@i].TimeStamp" value="@Model.Lyrics[i].TimeStamp" />
                    </div>
                    <div class="lyrics-row">
                        <label for="lyric-japanese-@i">日文</label>
                        <input id="lyric-japanese-@i" type="text" name="lyrics[@i].Japanese" value="@Model.Lyrics[i].Japanese" />
                    </div>
                    <div class="lyrics-row">
                        <label for="lyric-chinese-@i">中文</label>
                        <input id="lyric-chinese-@i" type="text" name="lyrics[@i].Chinese" value="@Model.Lyrics[i].Chinese" />
                    </div>
                    <div class="lyrics-row">
                        <label for="lyric-roman-@i">羅馬音</label>
                        <input id="lyric-roman-@i" type="text" name="lyrics[@i].Roman" value="@Model.Lyrics[i].Roman" />
                    </div>
                </div>
            }
        </div>
    </div>
</main>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let videoPlayer = document.getElementById("songPlayer");
        let videoSource = document.getElementById("videoSource");
        const markTimeBtn = document.getElementById("markTimeBtn");
        const undoMarkTimeBtn = document.getElementById("undoMarkTimeBtn"); // 返回上一個標記按鈕
        const markingProgress = document.getElementById("markingProgress");
        let totalLyrics = @Model.Lyrics.Count;
        let currentIndex = 0;
        let youtubePlayer = null;
        let lyricsScrollContainer = document.querySelector(".lyrics-container").parentElement;

        function updateProgress() {
            markingProgress.textContent = `標記進度：${currentIndex} / ${totalLyrics}`;
        }

        function scrollToCurrentLyric() {
            if (currentIndex < totalLyrics) {
                let currentCard = document.querySelectorAll(".lyrics-card")[currentIndex-1];
                if (currentCard && lyricsScrollContainer) {
                    lyricsScrollContainer.scrollTo({
                        top: currentCard.offsetTop - lyricsScrollContainer.offsetTop,
                        behavior: "smooth"
                    });
                }
            }
        }

        function markCardAsCompleted(index) {
            let cards = document.querySelectorAll(".lyrics-card");
            if (index < cards.length) {
                let card = cards[index];
                card.classList.add("marked");
                if (!card.querySelector(".marked-label")) {
                    let label = document.createElement("span");
                    label.className = "marked-label";
                    label.textContent = "✅ 已標記";
                    card.appendChild(label);
                }
            }
        }

        function unmarkCard(index) {
            let cards = document.querySelectorAll(".lyrics-card");
            if (index < cards.length) {
                let card = cards[index];
                card.classList.remove("marked");
                let label = card.querySelector(".marked-label");
                if (label) {
                    label.remove();
                }
            }
        }

        // **檢查是否為 YouTube 影片**
        function isYouTubeVideo(url) {
            return url.includes("youtube.com") || url.includes("youtu.be");
        }

        // **如果是 YouTube，轉換為嵌入格式**
        function getYouTubeEmbedUrl(youtubeUrl) {
            try {
                let url = new URL(youtubeUrl);
                let videoId = url.searchParams.get("v") || url.pathname.split("/").pop();
                return videoId ? `https://www.youtube.com/embed/${videoId}?enablejsapi=1&autoplay=1&controls=1` : null;
            } catch {
                return null;
            }
        }

        // **如果是 YouTube 影片，改用 YouTube API 播放**
        if (isYouTubeVideo(videoSource.src)) {
            let embedUrl = getYouTubeEmbedUrl(videoSource.src);
            videoPlayer.outerHTML = `<div id="ytPlayer"></div>`; // 替換掉原本的 video 標籤
            loadYouTubeAPI(embedUrl);
        }

        function loadYouTubeAPI(embedUrl) {
            let tag = document.createElement("script");
            tag.src = "https://www.youtube.com/iframe_api";
            let firstScriptTag = document.getElementsByTagName("script")[0];
            firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

            window.onYouTubeIframeAPIReady = function () {
                youtubePlayer = new YT.Player("ytPlayer", {
                    height: "100%",
                    width: "100%",
                    videoId: embedUrl.split("/").pop().split("?")[0],
                    playerVars: {
                        "autoplay": 1,
                        "controls": 1,
                        "modestbranding": 1,
                        "rel": 0,
                        "showinfo": 0,
                        "playsinline": 1
                    }
                });
            };
        }

        // **標記時間**
        markTimeBtn.addEventListener("click", function () {
            let currentTime = 0;

            if (videoPlayer && !isYouTubeVideo(videoSource.src)) {
                currentTime = videoPlayer.currentTime;
            } else if (youtubePlayer) {
                currentTime = youtubePlayer.getCurrentTime();
            }

            let timestampInputs = document.querySelectorAll("input[name$='TimeStamp']");
            if (currentIndex < timestampInputs.length) {
                timestampInputs[currentIndex].value = currentTime.toFixed(1);
                markCardAsCompleted(currentIndex); // 標記已完成
                currentIndex++;
                updateProgress();
                scrollToCurrentLyric(); // 確保滾動到最上方的卡片
            } else {
                alert("所有時間已標記完成！");
            }
        });

        function syncScroll() {
            let currentTime = 0;
            if (videoPlayer && !isYouTubeVideo(videoSource.src)) {
                currentTime = videoPlayer.currentTime;
            } else if (youtubePlayer) {
                currentTime = youtubePlayer.getCurrentTime();
            }

            let timestamps = Array.from(document.querySelectorAll("input[name$='TimeStamp']"));
            let closestIndex = timestamps.findIndex(input => parseFloat(input.value) > currentTime);
            if (closestIndex > 0) closestIndex--; // 讓滾動更自然

            let currentCard = document.querySelectorAll(".lyrics-card")[closestIndex];
            if (currentCard) {
                currentCard.scrollIntoView({ behavior: "smooth", block: "center" });
            }
        }

        if (videoPlayer) {
            videoPlayer.addEventListener("timeupdate", syncScroll);
        }

        // 依據標記進度來標示已完成的卡片
        function updateMarkedCards() {
            document.querySelectorAll(".lyrics-card").forEach((card, index) => {
                if (index < currentIndex) {
                    markCardAsCompleted(index);
                }
            });
        }

        // **返回上一個標記**
        undoMarkTimeBtn.addEventListener("click", function () {
            if (currentIndex > 0) {
                currentIndex--; // 倒退一個標記
                unmarkCard(currentIndex); // 取消標記樣式
                updateProgress();
                scrollToCurrentLyric(); // 滾動回上一個標記的卡片
            } else {
                alert("沒有標記可以返回！");
            }
        });

        updateProgress();
        updateMarkedCards();

        document.querySelectorAll(".lyrics-card").forEach(card => {
            const handle = card.querySelector(".drag-handle");
            card.setAttribute("draggable", "true");

            handle.addEventListener("mousedown", function () {
                card.classList.add("draggable-enabled");
            });

            handle.addEventListener("mouseup", function () {
                card.classList.remove("draggable-enabled");
            });
        });

        const lyricsContainer = document.querySelector(".lyrics-container");

        lyricsContainer.addEventListener("dragstart", function (e) {
            if (e.target.classList.contains("draggable-enabled")) {
                draggedCard = e.target.closest(".lyrics-card");
                e.dataTransfer.setData("text/plain", "");
                draggedCard.classList.add("dragging");
                e.dataTransfer.effectAllowed = "move";
            } else {
                e.preventDefault();
            }
        });

        lyricsContainer.addEventListener("dragover", function (e) {
            e.preventDefault();
            const afterElement = getDragAfterElement(lyricsContainer, e.clientY);
            if (afterElement == null) {
                lyricsContainer.appendChild(draggedCard);
            } else {
                lyricsContainer.insertBefore(draggedCard, afterElement);
            }
        });

        lyricsContainer.addEventListener("dragend", function () {
            if (draggedCard) {
                draggedCard.classList.remove("dragging");
                draggedCard = null;

                let newOrder = [];
                document.querySelectorAll(".lyrics-card").forEach(card => {
                    newOrder.push(parseInt(card.dataset.id));
                });

                console.log("Sending order:", newOrder);

                let url = "@Url.Action("UpdateOrder", "Media")";
                fetch(url, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        songUid: songUid,
                        newOrder: newOrder
                    })
                })
                .then(response => response.json())
                .then(data => console.log("Order updated successfully:", data))
                .catch(error => console.error("Failed to update order:", error));
            }
        });

        function getDragAfterElement(container, y) {
            const draggableElements = [...container.querySelectorAll(".lyrics-card:not(.dragging)")];

            return draggableElements.reduce((closest, child) => {
                const box = child.getBoundingClientRect();
                const offset = y - box.top - box.height / 2;
                if (offset < 0 && offset > closest.offset) {
                    return { offset: offset, element: child };
                } else {
                    return closest;
                }
            }, { offset: Number.NEGATIVE_INFINITY }).element;
        }

        const saveBtn = document.getElementById("saveLyricsBtn");

        saveBtn.addEventListener("click", function () {
            let songUid = document.getElementById("songUid").value.trim();
            if (!songUid) {
                alert("錯誤：songUid 無效！");
                return;
            }

            let lyrics = [];
            document.querySelectorAll(".lyrics-card").forEach(card => {
                let lyricID = card.dataset.id ? parseInt(card.dataset.id) : null;
                let timeStamp = card.querySelector('input[name$=".TimeStamp"]')?.value;
                let japanese = card.querySelector('input[name$=".Japanese"]')?.value;
                let chinese = card.querySelector('input[name$=".Chinese"]')?.value;
                let roman = card.querySelector('input[name$=".Roman"]')?.value;

                if (lyricID !== null && timeStamp !== undefined) {
                    lyrics.push({
                        LyricID: lyricID,
                        TimeStamp: parseFloat(timeStamp),
                        Japanese: japanese || "",
                        Chinese: chinese || "",
                        Roman: roman || ""
                    });
                }
            });

            if (lyrics.length === 0) {
                alert("沒有可存檔的歌詞內容！");
                return;
            }

            let url = "@Url.Content("~/Media/EditLyrics")";
            const saveStatus = document.getElementById("lyricsSaveStatus");
            saveStatus.textContent = "正在存檔…";
            saveBtn.disabled = true;
            fetch(url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    songUid: songUid,
                    lyrics: lyrics
                })
            })
            .then(response => {
                if (!response.ok) throw new Error("存檔失敗，請稍後再試。");
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    alert("歌詞存檔成功！");
                    window.location.href = data.redirectUrl;
                } else {
                    saveStatus.textContent = data.message || "存檔失敗，請確認欄位後再試。";
                }
            })
            .catch(() => { saveStatus.textContent = "存檔失敗，請稍後再試；尚未確認儲存成功。"; })
            .finally(() => { saveBtn.disabled = false; });
        });

        document.querySelector(".lyrics-container").addEventListener("click", function (event) {
            let songUid = document.getElementById("songUid").value.trim();
            if (event.target.classList.contains("delete-btn")) {
                const lyricId = event.target.dataset.id;

                let url = "@Url.Content("~/Media/DeleteLyric")";
                if (confirm("確定要刪除這行歌詞嗎？")) {
                    fetch(url, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ lyricId: parseInt(lyricId), songUid: songUid })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            event.target.closest(".lyrics-card").remove();
                            console.log("刪除成功");
                        } else {
                            console.error("刪除失敗", data.message);
                        }
                    })
                    .catch(error => console.error("刪除請求失敗：", error));
                }
            }
        });
    });
</script>
