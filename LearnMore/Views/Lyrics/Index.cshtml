    function loadYouTubeAPI() {
        installYouTubeIframeAllowSanitizer();
        if (!window.YT || !YT.Player) {
            const tag = document.createElement("script");
            tag.src = "https://www.youtube.com/iframe_api";
            const firstScriptTag = document.getElementsByTagName("script")[0];
            firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
        }
    }

    function installYouTubeIframeAllowSanitizer() {
        if (window.__learnMoreYouTubeAllowSanitizerInstalled) {
            return;
        }
        window.__learnMoreYouTubeAllowSanitizerInstalled = true;

        const sanitizeAllow = value => String(value || '')
            .split(';')
            .map(part => part.trim())
            .filter(part => part && part !== 'web-share')
            .join('; ');

        const originalSetAttribute = HTMLIFrameElement.prototype.setAttribute;
        HTMLIFrameElement.prototype.setAttribute = function(name, value) {
            if (String(name).toLowerCase() === 'allow') {
                return originalSetAttribute.call(this, name, sanitizeAllow(value));
            }

            return originalSetAttribute.call(this, name, value);
        };

        const allowDescriptor = Object.getOwnPropertyDescriptor(HTMLIFrameElement.prototype, 'allow');
        if (allowDescriptor && allowDescriptor.set) {
            Object.defineProperty(HTMLIFrameElement.prototype, 'allow', {
                configurable: true,
                enumerable: allowDescriptor.enumerable,
                get: allowDescriptor.get,
                set(value) {
                    allowDescriptor.set.call(this, sanitizeAllow(value));
                }
            });
        }
    }

    window.onYouTubeIframeAPIReady = function () {
        youtubePlayer = new YT.Player('youtube-player', {
            height: '360',
            width: '640',
            videoId: '@youtubeVideoId',
            events: {
                'onReady': onYouTubePlayerReady,
                'onStateChange': onPlayerStateChange
            }
        });
    };

    function onYouTubePlayerReady() {
        const karaokeAudio = getKaraokeAudioPlayer();
        if (karaokeAudioActive && karaokeAudio && !karaokeAudio.paused) {
            syncOriginalPlaybackToKaraoke(true, true);
        }
    }

    // 預設隱藏羅馬拼音
    document.addEventListener("DOMContentLoaded", function() {
        loadYouTubeAPI();

        // 確保所有播放按鈕初始狀態為 `fa-play`
        updatePlaybackButtons(false);

        var privateCommentCheckbox = document.getElementById("private-comment");
        if (privateCommentCheckbox?.dataset.loginRequired === "true") {
            const privateCommentOption = privateCommentCheckbox.closest(".comment-options > div");
            const showPrivateLoginPrompt = function (event) {
                event.preventDefault();
                event.stopPropagation();
                privateCommentCheckbox.checked = false;
                alert("登入後才能使用私密留言唷！");
            };

            privateCommentOption?.addEventListener("click", showPrivateLoginPrompt, true);
            privateCommentCheckbox.addEventListener("change", function () {
                privateCommentCheckbox.checked = false;
            });
        }

        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipTriggerList.forEach(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

        document.querySelectorAll('.karaoke-audio-player').forEach(karaokeAudio => {
            karaokeAudio.addEventListener('play', () => {
                if (karaokeAudioActive && karaokeAudio === getKaraokeAudioPlayer()) {
                    syncOriginalPlaybackToKaraoke(true, true);
                }
            });
            karaokeAudio.addEventListener('pause', () => {
                if (karaokeAudioActive && karaokeAudio === getKaraokeAudioPlayer() && !karaokeAudio.ended) {
                    syncOriginalPlaybackToKaraoke(false, true);
                }
            });
            karaokeAudio.addEventListener('seeked', () => {
                if (karaokeAudioActive && karaokeAudio === getKaraokeAudioPlayer() && !karaokeAudio.paused) {
                    syncOriginalPlaybackToKaraoke(true, true);
                }
            });
        });

        const videoPlayer = getOriginalVideoPlayer();
        if (videoPlayer) {
            videoPlayer.addEventListener('pause', () => {
                if (isKaraokeOriginalControlEvent()) {
                    return;
                }
                pauseKaraokeAudioFromOriginalPlayback();
            });
            videoPlayer.addEventListener('play', () => {
                if (isKaraokeOriginalControlEvent()) {
                    return;
                }
                playKaraokeAudioFromOriginalPlayback();
            });
            videoPlayer.addEventListener('seeked', () => {
                if (isKaraokeOriginalControlEvent()) {
                    return;
                }
                syncKaraokeAudioTimeFromOriginalPlayback();
            });
        }
    });

    function pausePlayback(time) {
        let isPaused = isPlaybackPaused();

        if (isPaused) {
            playPlayback();
            updatePlaybackButtons(true); // 設定圖示為 `fa-pause`
        } else {
            pausePlaybackMedia();
            updatePlaybackButtons(false); // 設定圖示為 `fa-play`
        }
    }

    function updatePlaybackButtons(isPlaying) {
        document.querySelectorAll('.controls button').forEach(button => {
            const icon = button.querySelector('i.fas.fa-pause, i.fas.fa-play');
            if (icon) {
                if (isPlaying) {
                    icon.classList.remove("fa-play");
                    icon.classList.add("fa-pause");
                    button.setAttribute("title", "暫停");
                    button.setAttribute("data-bs-original-title", "暫停");
                    button.setAttribute("aria-label", "暫停");
                } else {
                    icon.classList.remove("fa-pause");
                    icon.classList.add("fa-play");
                    button.setAttribute("title", "播放");
                    button.setAttribute("data-bs-original-title", "播放");
                    button.setAttribute("aria-label", "播放");
                }
            }

            const tooltipInstance = bootstrap.Tooltip.getInstance(button);
            if (tooltipInstance && typeof tooltipInstance.update === 'function') {
                tooltipInstance.update();
            } else if (!tooltipInstance) {
                new bootstrap.Tooltip(button);
            }
        });
    }

    function startPlayback(time) {
        seekPlayback(time, true);
        disableReplayButtons();
    }

    function replayLine(time, buttonId) {
        const buttonElement = document.getElementById(buttonId);

        // 停止重播模式時處理
        if (isReplaying && replayInterval) {
            clearInterval(replayInterval);
            replayInterval = null;
            isReplaying = false;

            // 清除所有按鈕的 active 樣式
            document.querySelectorAll('.controls button.active').forEach(btn => {
                btn.classList.remove('active');
            });

            return; // 停止重播
        }

        // 啟動重播模式時處理
        isReplaying = true;

        // 清除所有其他按鈕的 active 樣式
        document.querySelectorAll('.controls button.active').forEach(btn => {
            btn.classList.remove('active');
        });

        // 為當前按鈕添加 active 樣式
        if (buttonElement) {
            buttonElement.classList.add('active');
        }

        const lineEndTime = getNextLineTime(time);

        // 設置重播間隔
        replayInterval = setInterval(() => {
            const currentTime = getPlaybackTime();
            if (currentTime < time || currentTime >= lineEndTime) {
                seekPlayback(time, true);
            }
        }, 100);

        // 跳轉到指定時間並播放
        seekPlayback(time, true);
    }

    function getNextLineTime(currentTime) {
        // 找到當前行的結束時間（下一行的時間戳）
        for (let i = 0; i < lyrics.length; i++) {
            if (lyrics[i].TimeStamp === currentTime && i < lyrics.length - 1) {
                return lyrics[i + 1].TimeStamp;
            }
        }
        // 如果是最後一行，設置為歌曲結束時間
        return getPlaybackDuration();
    }

    function jumpToLyric(time) {
        seekPlayback(time, true);
         // 更新所有播放/暫停按鈕圖示為「播放中」狀態（fa-pause）
        updatePlaybackButtons(true);
    }

    function disableReplayButtons() {
        isReplaying = false;

        // 停止任何重播間隔
        if (replayInterval) {
            clearInterval(replayInterval);
            replayInterval = null;
        }

        // 移除所有 replay 按鈕的 active 樣式
        document.querySelectorAll('.controls button.active').forEach(btn => {
            btn.classList.remove('active');
        });
    }

    let currentMode = 1;

    function switchMode(mode) {
        currentMode = mode;
        for (let i = 1; i <= 6; i++) {
            const modeEl = document.getElementById('mode-' + i);
            const tabEl = document.getElementById('tab-button-' + i);
            if (modeEl) modeEl.style.display = (i === mode) ? 'flex' : 'none';
            if (tabEl) tabEl.classList.toggle('active', i === mode);
        }
        updateKaraokeAudioPanel();
        updateLyricsDisplay(getKaraokeLyricsDisplayTime(getCurrentTime()));
    }

    function getCurrentTime() {
        return getPlaybackTime();
    }

    function revealTranslation(timestamp) {
        const cnEl = document.getElementById('mode4-cn-' + timestamp);
        const btn = cnEl ? cnEl.nextElementSibling : null;
        if (cnEl) {
            cnEl.classList.remove('mode4-cn-hidden');
            cnEl.classList.add('mode4-cn-revealed');
        }
        if (btn) btn.style.display = 'none';
    }

    function revealJapanese(timestamp) {
        const jpEl = document.getElementById('mode5-jp-' + timestamp);
        const btn = jpEl ? jpEl.nextElementSibling : null;
        if (jpEl) {
            jpEl.classList.remove('mode5-jp-hidden');
            jpEl.classList.add('mode5-jp-revealed');
        }
        if (btn) btn.style.display = 'none';
    }

    function getCurrentLyricIndex(currentTime) {
        for (let i = 0; i < lyrics.length; i++) {
            if (currentTime >= lyrics[i].TimeStamp && (i === lyrics.length - 1 || currentTime < lyrics[i + 1].TimeStamp)) {
                return i;
            }
        }

        return -1;
    }

    function getModeLyricLines(mode) {
        const selector = {
            1: '#mode-1 .lyrics-line',
            4: '#mode-4 .mode4-line',
            5: '#mode-5 .mode5-line'
        }[mode];

        return selector ? document.querySelectorAll(selector) : [];
    }

    function scrollCurrentLyricIntoActiveMode(currentIndex) {
        if (!autoSyncLyrics || ![1, 4, 5].includes(currentMode)) {
            return;
        }

        const highlightedLine = getModeLyricLines(currentMode)[currentIndex];
        const lyricsCard = highlightedLine?.closest('.lyric-card');
        if (!highlightedLine || !lyricsCard) {
            return;
        }

        const timestamp = lyrics[currentIndex]?.TimeStamp;
        const scrollKey = `${currentMode}:${timestamp}`;
        if (scrollKey === lastScrolledTimestamp) {
            return;
        }

        lastScrolledTimestamp = scrollKey;
        lyricsCard.scrollTo({
            top: highlightedLine.offsetTop - lyricsCard.offsetTop - lyricsCard.clientHeight / 2,
            behavior: 'smooth',
        });
    }

    function updateMode456(currentTime) {
        let currentIndex = getCurrentLyricIndex(currentTime);

        if (currentIndex === -1) return;

        // Mode 4 highlight
        document.querySelectorAll('#mode-4 .mode4-line').forEach((line, idx) => {
            line.classList.toggle('highlight', idx === currentIndex);
        });

        // Mode 5 highlight
        document.querySelectorAll('#mode-5 .mode5-line').forEach((line, idx) => {
            line.classList.toggle('highlight', idx === currentIndex);
        });

        // Mode 6: karaoke display
        if (currentMode === 6) {
            const line = lyrics[currentIndex];
            const jpEl = document.getElementById('mode6-jp');
            const romanEl = document.getElementById('mode6-roman');
            const nextEl = document.getElementById('mode6-next');
            const nextJpEl = document.getElementById('mode6-next-jp');
            const nextRomanEl = document.getElementById('mode6-next-roman');
            const nextCnEl = document.getElementById('mode6-next-cn');
            if (jpEl) jpEl.innerHTML = line.Japanese || '';
            if (romanEl) romanEl.textContent = line.Roman || '';

            const nextLine = currentIndex < lyrics.length - 1 ? lyrics[currentIndex + 1] : null;
            if (nextEl) {
                nextEl.hidden = !nextLine;
            }
            if (nextJpEl) {
                nextJpEl.innerHTML = nextLine?.Japanese || '';
            }
            if (nextRomanEl) {
                nextRomanEl.textContent = nextLine?.Roman || '';
            }
            if (nextCnEl) {
                nextCnEl.textContent = nextLine?.Chinese || '';
            }

            // Progress bar within current line
            const lineStart = line.TimeStamp;
            const lineEnd = currentIndex < lyrics.length - 1 ? lyrics[currentIndex + 1].TimeStamp : lineStart + 5;
            const duration = lineEnd - lineStart;
            const elapsed = currentTime - lineStart;
            const pct = duration > 0 ? Math.min(100, (elapsed / duration) * 100) : 0;
            const fillEl = document.getElementById('mode6-progress-fill');
            if (fillEl) fillEl.style.width = pct + '%';
        }
    }

    let lastScrolledTimestamp = null; // 記錄上次滾動的時間戳，避免重複滾動

    function updateLyricsDisplay(currentTime) {
        const displayTime = getLyricsDisplayTime(currentTime);
        updateMode456(displayTime);
        let currentIndex = getCurrentLyricIndex(displayTime);

        if (currentIndex !== -1) {
            document.querySelectorAll('#mode-1 .lyrics-line').forEach((line, index) => {
                line.classList.toggle('highlight', index === currentIndex);
            });

            // 安全設定 innerHTML 的輔助函式（避免元素不存在時爆錯）
            const safeSet = (el, html) => { if (el) el.innerHTML = html || ''; };

            // 模式 2 Combined 區塊
            const previousLineCombined = document.getElementById('previous-lyric-combined');
            const currentLineCombined = document.getElementById('current-lyric-combined');
            const nextLineCombined = document.getElementById('next-lyric-combined');

            if (previousLineCombined) {
                safeSet(previousLineCombined.querySelector('.jp-line'), currentIndex > 0 ? lyrics[currentIndex - 1].Japanese : '');
                safeSet(previousLineCombined.querySelector('.cn-line'), currentIndex > 0 ? lyrics[currentIndex - 1].Chinese : '');
                safeSet(previousLineCombined.querySelector('.roman-line'), currentIndex > 0 ? (lyrics[currentIndex - 1].Roman || '') : '');
            }
            if (currentLineCombined) {
                safeSet(currentLineCombined.querySelector('.jp-line'), lyrics[currentIndex].Japanese);
                safeSet(currentLineCombined.querySelector('.cn-line'), lyrics[currentIndex].Chinese);
                safeSet(currentLineCombined.querySelector('.roman-line'), lyrics[currentIndex].Roman || '');
            }
            if (nextLineCombined) {
                safeSet(nextLineCombined.querySelector('.jp-line'), currentIndex < lyrics.length - 1 ? lyrics[currentIndex + 1].Japanese : '');
                safeSet(nextLineCombined.querySelector('.cn-line'), currentIndex < lyrics.length - 1 ? lyrics[currentIndex + 1].Chinese : '');
                safeSet(nextLineCombined.querySelector('.roman-line'), currentIndex < lyrics.length - 1 ? (lyrics[currentIndex + 1].Roman || '') : '');
            }

            window.learnMoreMikaAvatar?.onLyricChange?.({
                ...mikaAvatarSongContext,
                index: currentIndex,
                lyricId: lyrics[currentIndex].LyricID,
                timeStamp: lyrics[currentIndex].TimeStamp,
                japanese: lyrics[currentIndex].Japanese,
                chinese: lyrics[currentIndex].Chinese,
                roman: lyrics[currentIndex].Roman || ''
            });

            scrollCurrentLyricIntoActiveMode(currentIndex);
        }
    }

    function onPlayerStateChange(event) {
        if (karaokeAudioActive) {
            if (event.data === YT.PlayerState.PAUSED || event.data === YT.PlayerState.ENDED) {
                pauseKaraokeAudioFromOriginalPlayback();
            }
            if (event.data === YT.PlayerState.PLAYING) {
                playKaraokeAudioFromOriginalPlayback();
            }
            return;
        }

        if (event.data === YT.PlayerState.ENDED) {
            youtubePlayer.seekTo(0);
            youtubePlayer.playVideo();
        }
        if (event.data === YT.PlayerState.PLAYING) {
            const updateLyrics = () => {
                const currentTime = youtubePlayer.getCurrentTime();
                updateLyricsDisplay(currentTime);
                warmInactiveKaraokeAudio(currentTime);
                requestAnimationFrame(updateLyrics);
            };
            updateLyrics();
        }
    }

    function onVideoEnded() {
        const videoPlayer = document.getElementById('video-player');
        if (karaokeAudioActive) {
            pauseKaraokeAudioFromOriginalPlayback();
            return;
        }

        videoPlayer.currentTime = 0;
        videoPlayer.play();
    }

    function onKaraokeAudioEnded() {
        const karaokeAudio = getKaraokeAudioPlayer();
        if (karaokeAudio) {
            karaokeAudio.currentTime = 0;
            syncOriginalPlaybackToKaraoke(true, true);
            karaokeAudio.play().catch(error => {
                logKaraokePlaybackError(error);
            });
        }
    }

    function adjustControlsForScreenSize() {
        const controls = document.querySelectorAll('.controls');
        const isMobile = window.innerWidth <= 768;

        controls.forEach(control => {
            if (isMobile) {
                control.style.position = 'static';
                control.style.marginTop = '10px';
                control.style.justifyContent = 'center';
                control.querySelectorAll('button').forEach(button => {
                    button.style.fontSize = '12px';
                });
                control.querySelectorAll('.fas').forEach(icon => {
                    icon.style.fontSize = '12px';
                });
            } else {
                control.style.position = 'absolute';
                control.style.bottom = '2px';
                control.style.right = '10px';
                control.style.marginTop = '0';
                control.style.justifyContent = 'flex-start';
                control.querySelectorAll('button').forEach(button => {
                    button.style.fontSize = '14px';
                });
                control.querySelectorAll('.fas').forEach(icon => {
                    icon.style.fontSize = '14px';
                });
            }
        });
    }

    window.addEventListener('resize', adjustControlsForScreenSize);
    document.addEventListener('DOMContentLoaded', adjustControlsForScreenSize);

    function adjustFontSizeForLyrics() {
        const isMobile = window.innerWidth <= 768;
        document.querySelectorAll('.lyrics-line').forEach(line => {
            line.style.fontSize = isMobile ? '14px' : '18px';
        });
        document.querySelectorAll('.jp-line').forEach(line => {
            line.style.fontSize = isMobile ? '14px' : '18px';
        });
        document.querySelectorAll('.cn-line').forEach(line => {
            line.style.fontSize = isMobile ? '12px' : '14px';
        });
    }

    window.addEventListener('resize', adjustFontSizeForLyrics);
    document.addEventListener('DOMContentLoaded', adjustFontSizeForLyrics);

    // 修改 reportBug 函數，新增訊息輸入框
    function reportBug(lyricid) {
        if (lyricid) {
            const errorDescription = prompt("請描述您發現的問題：");
            if (errorDescription) {
                const bugReport = {
                    errorDescription: errorDescription,
                    errorSongUid: '@Model.SongUid',
                    errorLyricID: lyricid
                };

                let url = "@Url.Content("~/ReportBug")"
                fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(bugReport)
                })
                .then(response => {
                    if (response.ok) {
                        alert('已成功通知作者修正歌詞！');
                    } else {
                        alert('回報失敗，請稍後再試！');
                    }
                })
                .catch(error => {
                    console.error('回報錯誤時發生問題:', error);
                    alert('回報失敗，請稍後再試！');
                });
            }
        }
    }

    function scrollToCurrentLyric() {
        const highlightedLine = document.querySelector('.lyrics-line.highlight');
        if (highlightedLine) {
            highlightedLine.scrollIntoView({
                behavior: 'smooth',
                block: 'center',
            });
        }
    }

    function scrollToTop() {
        window.scrollTo({
            top: 0,
            behavior: 'smooth',
        });
    }

    document.getElementById("submit-comment").addEventListener("click", function () {
        var message = document.getElementById("comment-input").value.trim();
        var isPrivate = document.getElementById("private-comment").checked;

        if (!message) {
            alert("留言內容不能為空！");
            return;
        }

        var commentData = {
            songUid: "@Model.SongUid",
            message: message,
            isPrivate: isPrivate
        };

        fetch("@Url.Content("~/Lyrics/AddComment")", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(commentData)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                var commentSection = document.getElementById("comments-container");
                var noCommentsMessage = commentSection.querySelector(".no-comments");

                // 移除「目前沒有留言」的提示
                if (noCommentsMessage) {
                    noCommentsMessage.remove();
                }

                // 建立新留言元素
                var newComment = document.createElement("div");
                newComment.classList.add("comment");

                // **加入使用者頭像**
                var avatarElem = document.createElement("img");
                avatarElem.classList.add("avatar");
                avatarElem.src = data.avatar;
                avatarElem.alt = "使用者頭像";
                newComment.appendChild(avatarElem);

                // 顯示留言者名稱
                var userNameElem = document.createElement("strong");
                userNameElem.textContent = (data.userName || "訪客") + "：";
                newComment.appendChild(userNameElem);

                if (data.isPrivate) {
                    // 如果是悄悄話，顯示「🔒 悄悄話」
                    var privateLabel = document.createElement("span");
                    privateLabel.classList.add("private-label");
                    privateLabel.textContent = "🔒 悄悄話";
                    newComment.appendChild(privateLabel);

                    var currentUserEmail = "@Model.UserEmail";
                    // 只有當前使用者才顯示留言內容
                    if (data.userEmail === currentUserEmail) {
                        var messageElem = document.createElement("p");
                        messageElem.textContent = data.message;
                        newComment.appendChild(messageElem);
                    }
                } else {
                    // 如果是公開留言，顯示留言內容
                    var messageElem = document.createElement("p");
                    messageElem.textContent = data.message;
                    newComment.appendChild(messageElem);
                }

                // 顯示時間戳記
                var timestampElem = document.createElement("span");
                timestampElem.classList.add("timestamp");
                timestampElem.textContent = data.timeStamp;
                newComment.appendChild(timestampElem);

                // 新留言插入至最上方
                commentSection.insertBefore(newComment, commentSection.firstChild);

                // 清空輸入框
                document.getElementById("comment-input").value = "";
                document.getElementById("private-comment").checked = false;
            } else {
                alert("留言提交失敗：" + (data.message || "未知錯誤"));
            }
        })
        .catch(error => {
            console.error("留言提交時發生錯誤", error);
            alert("留言提交失敗，請稍後再試。");
        });
    });

    function submitReply(commentId) {
        var replyMessage = document.getElementById("reply-input-" + commentId).value.trim();
        if (!replyMessage) {
            alert("請輸入回覆內容！");
            return;
        }

        var replyData = {
            CommentId: commentId, // 傳送 GUID
            ReplyMessage: replyMessage
        };

        fetch("/Lyrics/ReplyComment", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(replyData)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert("回覆成功！");
                location.reload(); // 重新載入頁面以顯示最新回覆
            } else {
                alert("回覆失敗：" + data.message);
            }
        })
        .catch(error => {
            console.error("回覆時發生錯誤", error);
            alert("回覆失敗，請稍後再試。");
        });
    }

    // ========== 時間戳編輯功能 ==========
    @if (Model.CanEditTimestamp)
    {
        <text>
    var songUid = "@Model.SongUid";
    var updateTimestampUrl = "@Url.Action("UpdateTimestamp", "Lyrics")";
    
    // 切換時間戳編輯模式
    // 記住編輯前的自動同步狀態
    let syncStateBeforeEdit = null;
    
    document.getElementById('edit-timestamp-toggle')?.addEventListener('change', function() {
        var editors = document.querySelectorAll('.timestamp-editor');
        var isEditing = this.checked;
        var syncToggle = document.getElementById('sync-lyrics-toggle');
        
        editors.forEach(function(editor) {
            editor.style.display = isEditing ? 'flex' : 'none';
        });
        
        if (isEditing) {
            // 進入編輯模式：記住當前狀態，然後關閉自動同步
            syncStateBeforeEdit = syncToggle.checked;
            syncToggle.checked = false;
            autoSyncLyrics = false;
        } else {
            // 離開編輯模式：恢復之前的狀態
            if (syncStateBeforeEdit !== null) {
                syncToggle.checked = syncStateBeforeEdit;
                autoSyncLyrics = syncStateBeforeEdit;
                syncStateBeforeEdit = null;
            }
        }
    });
    
    // 儲存時間戳
    function saveTimestamp(button, lyricId) {
        var editor = button.closest('.timestamp-editor');
        var input = editor.querySelector('.timestamp-input');
        var newTimestamp = parseFloat(input.value);
        var originalTimestamp = parseFloat(input.dataset.original);
        
        if (isNaN(newTimestamp) || newTimestamp < 0) {
            alert('請輸入有效的時間戳');
            return;
        }
        
        // 顯示載入狀態
        button.disabled = true;
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
        
        fetch(updateTimestampUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                SongUid: songUid,
                LyricID: lyricId,
                NewTimestamp: newTimestamp
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // 更新成功，更新 DOM
                input.dataset.original = newTimestamp;
                var lyricsLine = button.closest('.lyrics-line');
                lyricsLine.dataset.timestamp = newTimestamp;
                lyricsLine.id = 'lyric-' + newTimestamp;
                
                button.innerHTML = '<i class="fas fa-check" style="color: green;"></i>';
                setTimeout(function() {
                    button.innerHTML = '<i class="fas fa-check"></i>';
                    button.disabled = false;
                }, 1500);
            } else {
                alert('更新失敗：' + data.message);
                input.value = originalTimestamp;
                button.innerHTML = '<i class="fas fa-check"></i>';
                button.disabled = false;
            }
        })
        .catch(error => {
            console.error('更新時間戳失敗', error);
            alert('更新失敗，請稍後再試');
            input.value = originalTimestamp;
            button.innerHTML = '<i class="fas fa-check"></i>';
            button.disabled = false;
        });
    }
    
    // 捕捉當前播放時間
    function captureCurrentTime(button) {
        var currentTime = getCurrentTime();
        if (currentTime !== null) {
            var editor = button.closest('.timestamp-editor');
            var input = editor.querySelector('.timestamp-input');
            input.value = currentTime.toFixed(2);
            
            // 視覺反饋
            input.style.backgroundColor = '#e8f5e9';
            setTimeout(function() {
                input.style.backgroundColor = '';
            }, 500);
        }
    }
    
    // 取得當前播放時間（支援 YouTube 和 HTML5 Video）
    function getCurrentTime() {
        return getPlaybackTime();
    }
        </text>
    }
</script>

