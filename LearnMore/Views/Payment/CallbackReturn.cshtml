@model LearnMore.Models.PaymentCallbackViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="lm-page-card lm-page-card-wide">
    <h1 class="lm-page-title">@Model.Title</h1>
    <dl>
        @foreach (var field in Model.Fields)
        {
            <dt>@field.Name</dt>
            <dd>@field.Value</dd>
        }
    </dl>
</div>
