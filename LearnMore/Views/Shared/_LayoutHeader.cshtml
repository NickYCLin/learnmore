<script>
    document.addEventListener('DOMContentLoaded',function(){
        const body=document.body;const saved=localStorage.getItem('theme');if(saved==='dark-theme') body.classList.add('dark-theme');
        
        // 桌面版和手機版主題切換
        document.querySelectorAll('#themeToggle, #themeToggleMobile, .theme-toggle').forEach(t=>t.addEventListener('click',e=>{
            e.preventDefault();
            e.stopPropagation();
            const dark=body.classList.toggle('dark-theme');
            localStorage.setItem('theme',dark?'dark-theme':'');
        }));

        // 群組播放 inline (首頁上處理，這裡只保留樣式與通用功能)

        const searchForm = document.querySelector('.search-form[data-search-url]');
        const searchContainer = searchForm?.closest('.search-container');
        const searchInput = searchForm?.querySelector('.search-input');
        const searchSuggestions = document.getElementById('search-suggestions');
        const searchBackdrop = searchContainer?.querySelector('.search-mobile-backdrop');
        let searchTimer = null;
        let searchAbortController = null;
        let searchRequestSequence = 0;
        let activeSuggestionIndex = -1;
        let currentSuggestions = [];
        const searchSuggestionCache = new Map();

        const matchLabels = {
            title: '歌名',
            artist: '歌手',
            translator: '譯者',
            chinese_title: '中文歌名',
            alternate_title: '別名',
            romaji: '羅馬拼音',
            user_alias: '別名',
            song: '歌曲'
        };

        function isSearchMobileLayout() {
            return window.matchMedia('(max-width: 991.98px)').matches;
        }

        function applySearchRwdLayout() {
            if (!searchContainer || !searchInput || !searchSuggestions) return;

            if (!searchSuggestions.classList.contains('show') || !isSearchMobileLayout()) {
                searchContainer.classList.remove('search-mobile-active');
                searchSuggestions.classList.remove('search-suggestions-mobile-fixed');
                searchSuggestions.style.top = '';
                return;
            }

            const rect = searchInput.getBoundingClientRect();
            searchSuggestions.style.top = `${Math.round(rect.bottom + 8)}px`;
            searchSuggestions.classList.add('search-suggestions-mobile-fixed');
            searchContainer.classList.add('search-mobile-active');
        }

        function hideSearchSuggestions() {
            if (!searchSuggestions || !searchInput) return;
            searchSuggestions.classList.remove('show');
            searchSuggestions.classList.remove('search-suggestions-mobile-fixed');
            searchSuggestions.style.top = '';
            searchContainer?.classList.remove('search-mobile-active');
            searchSuggestions.innerHTML = '';
            searchInput.setAttribute('aria-expanded', 'false');
            activeSuggestionIndex = -1;
            currentSuggestions = [];
        }

        function setActiveSuggestion(index) {
            if (!searchSuggestions) return;
            const items = Array.from(searchSuggestions.querySelectorAll('.search-suggestion-item'));
            items.forEach(item => item.classList.remove('active'));
            activeSuggestionIndex = index;
            if (items[index]) {
                items[index].classList.add('active');
                items[index].scrollIntoView({ block: 'nearest' });
            }
        }

        function renderSearchSuggestions(items) {
            if (!searchSuggestions || !searchInput) return;
            currentSuggestions = items || [];
            activeSuggestionIndex = -1;

            if (!currentSuggestions.length) {
                searchSuggestions.innerHTML = '<div class="search-suggestion-empty">找不到符合的歌曲，試試中文歌名、歌手或部分關鍵字</div>';
                searchSuggestions.classList.add('show');
                searchInput.setAttribute('aria-expanded', 'true');
                applySearchRwdLayout();
                return;
            }

            searchSuggestions.innerHTML = currentSuggestions.map((item, index) => {
                const imageUrl = item.thumbnailUrl || item.cover;
                const cover = imageUrl
                    ? `<img class="search-suggestion-cover" src="${escapeHtml(imageUrl)}" alt="" data-search-suggestion-cover="true">`
                    : fallbackSearchSuggestionIcon();
                const label = matchLabels[item.matchedBy] || item.matchedBy || '命中';
                return `<button type="button" class="search-suggestion-item" role="option" data-index="${index}" data-url="${escapeHtml(item.url || '')}">
                    ${cover}
                    <span class="search-suggestion-main">
                        <span class="search-suggestion-title">${escapeHtml(item.title || '')}</span>
                        <span class="search-suggestion-meta">${escapeHtml(item.artist || '')}</span>
                        <span class="search-suggestion-match">${escapeHtml(label)}：${escapeHtml(item.matchedText || '')}</span>
                    </span>
                </button>`;
            }).join('');
            searchSuggestions.querySelectorAll('[data-search-suggestion-cover="true"]').forEach(img => {
                img.addEventListener('error', () => {
                    img.outerHTML = fallbackSearchSuggestionIcon();
                }, { once: true });
            });
            searchSuggestions.classList.add('show');
            searchInput.setAttribute('aria-expanded', 'true');
            applySearchRwdLayout();
        }

        function escapeHtml(value) {
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function fallbackSearchSuggestionIcon() {
            return '<div class="search-suggestion-cover search-suggestion-placeholder"><i class="fas fa-music"></i></div>';
        }

        function openSearchSuggestion(item) {
            if (item?.url) {
                window.location.href = item.url;
            }
        }

        async function loadSearchSuggestions() {
            if (!searchForm || !searchInput) return;
            const query = searchInput.value.trim();
            if (query.length < 1) {
                searchAbortController?.abort();
                hideSearchSuggestions();
                return;
            }

            if (searchSuggestionCache.has(query)) {
                renderSearchSuggestions(searchSuggestionCache.get(query));
                return;
            }

            searchAbortController?.abort();
            searchAbortController = new AbortController();
            const requestSequence = ++searchRequestSequence;

            try {
                const endpoint = searchForm.dataset.searchUrl || '/api/search/suggestions';
                const response = await fetch(`${endpoint}?q=${encodeURIComponent(query)}`, {
                    headers: { 'Accept': 'application/json' },
                    signal: searchAbortController.signal
                });
                if (!response.ok) {
                    hideSearchSuggestions();
                    return;
                }
                const items = await response.json();
                if (requestSequence !== searchRequestSequence || searchInput.value.trim() !== query) return;
                searchSuggestionCache.set(query, items);
                if (searchSuggestionCache.size > 40) {
                    searchSuggestionCache.delete(searchSuggestionCache.keys().next().value);
                }
                renderSearchSuggestions(items);
            } catch (error) {
                if (error?.name === 'AbortError') return;
                hideSearchSuggestions();
            }
        }

        if (searchForm && searchInput && searchSuggestions) {
            searchInput.addEventListener('input', () => {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(loadSearchSuggestions, 180);
            });

            searchInput.addEventListener('keydown', event => {
                if (!searchSuggestions.classList.contains('show')) return;
                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    setActiveSuggestion(Math.min(activeSuggestionIndex + 1, currentSuggestions.length - 1));
                } else if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    setActiveSuggestion(Math.max(activeSuggestionIndex - 1, 0));
                } else if (event.key === 'Enter' && activeSuggestionIndex >= 0) {
                    event.preventDefault();
                    openSearchSuggestion(currentSuggestions[activeSuggestionIndex]);
                } else if (event.key === 'Escape') {
                    hideSearchSuggestions();
                }
            });

            searchSuggestions.addEventListener('mousedown', event => {
                const button = event.target.closest('.search-suggestion-item');
                if (!button) return;
                event.preventDefault();
                const index = Number(button.dataset.index);
                openSearchSuggestion(currentSuggestions[index]);
            });

            searchBackdrop?.addEventListener('mousedown', event => {
                event.preventDefault();
                hideSearchSuggestions();
            });

            window.addEventListener('resize', applySearchRwdLayout);
            window.addEventListener('orientationchange', applySearchRwdLayout);

            document.addEventListener('click', event => {
                if (!event.target.closest('.search-container')) {
                    hideSearchSuggestions();
                }
            });
        }
    });
</script>
