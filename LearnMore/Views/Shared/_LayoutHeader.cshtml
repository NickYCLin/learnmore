                font-size: 14px !important;
            }

            .search-container {
                width: 100% !important;
                padding: 0 16px;
            }

            .btn {
                padding: 8px 16px;
                font-size: 0.9rem;
            }

            .title-container {
                padding: 16px;
            }

            .main-content {
                flex-direction: column;
            }

            /* 手機版選單樣式 */
            .mobile-menu {
                width: 100%;
                padding: 8px 0;
                margin-top: 8px;
                border-top: 1px solid var(--border-color);
            }

            .mobile-menu .nav-item {
                width: 100%;
            }

            .mobile-menu .nav-link {
                display: flex !important;
                align-items: center !important;
                padding: 12px 16px !important;
                color: var(--text-primary) !important;
                font-weight: 500 !important;
                border-radius: 8px !important;
                margin: 2px 8px !important;
                transition: background 0.15s ease !important;
            }

            .mobile-menu .nav-link:hover {
                background: var(--bg-tertiary) !important;
                color: var(--primary-color) !important;
            }

            .mobile-menu .nav-link i {
                width: 24px !important;
                margin-right: 12px !important;
                text-align: center !important;
                font-size: 16px !important;
            }

            .mobile-menu .nav-link.text-danger {
                color: var(--danger-color) !important;
            }

            .mobile-menu .nav-divider {
                height: 1px;
                background: var(--border-color);
                margin: 8px 16px;
                opacity: 0.5;
            }

            .mobile-menu .mobile-theme-toggle {
                display: flex !important;
                align-items: center !important;
                justify-content: space-between !important;
                padding: 12px 16px !important;
                margin: 2px 8px !important;
                color: var(--text-primary) !important;
                font-weight: 500 !important;
                background: var(--bg-secondary) !important;
                border-radius: 8px !important;
            }

            .mobile-menu .mobile-theme-toggle span {
                display: flex;
                align-items: center;
            }

            .mobile-menu .mobile-theme-toggle span i {
                width: 24px;
                margin-right: 12px;
                text-align: center;
                font-size: 16px;
            }

            /* 手機版主題切換按鈕加強 */
            .mobile-menu .theme-toggle {
                width: 64px !important;
                height: 32px !important;
                border: 2px solid var(--primary-color) !important;
                background: var(--bg-tertiary) !important;
            }

            .mobile-menu .theme-toggle .toggle-indicator {
                width: 24px !important;
                height: 24px !important;
                top: 2px !important;
            }

            .mobile-menu .theme-toggle .toggle-icon {
                font-size: 14px !important;
            }

            .dark-theme .mobile-menu .theme-toggle .toggle-indicator {
                left: 34px !important;
            }
        }

        /*-------------------------------------------
                           關閉 AOS 動畫
                        -------------------------------------------*/
        [data-aos] {
            transform: none !important;
            opacity: 1 !important;
            transition: none !important;
        }

        /*-------------------------------------------
                           群組播放按鈕樣式
                        -------------------------------------------*/
        .group-play-inline-btn {
