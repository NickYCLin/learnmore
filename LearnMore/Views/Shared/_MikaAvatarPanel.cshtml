@{
    var avatarBaseUrl = "https://ycspace.myvnc.com/mika-avatar";
}

<aside class="mika-avatar-panel"
       data-mika-avatar-panel
       data-avatar-base-url="@avatarBaseUrl"
       data-avatar-image-url="@($"{avatarBaseUrl}/avatars/mao.png")"
       data-avatar-ws-url="wss://ycspace.myvnc.com/mika-avatar/client-ws"
       data-avatar-framing="lyrics-rail"
       data-avatar-id="mao_pro"
       data-avatar-runtime="live2d"
       aria-label="角色">
    <div class="mika-avatar-stage">
        <iframe class="mika-avatar-live2d"
                src="about:blank"
                title="角色 runtime"
                loading="eager"
                data-mika-avatar-live2d></iframe>
        <div class="mika-avatar-switcher" data-mika-avatar-switcher aria-label="選擇角色">
            <button type="button" data-mika-avatar-choice="mao_pro">mao_pro</button>
        </div>
        <img class="mika-avatar-image mika-avatar-fallback"
             src="@($"{avatarBaseUrl}/avatars/mao.png")"
             alt="mao_pro"
             loading="lazy"
             onerror="this.style.display='none';" />
        <span class="mika-avatar-status" data-mika-avatar-status aria-label="連線狀態"></span>
    </div>
    <div class="mika-avatar-console">
        <div class="mika-avatar-header">
            <strong data-mika-avatar-display-name>mao_pro</strong>
            <button type="button" class="mika-avatar-connect" data-mika-avatar-connect>連線</button>
        </div>
        <div class="mika-avatar-message" data-mika-avatar-message>待機中</div>
        <form class="mika-avatar-form" data-mika-avatar-form>
            <input type="text" data-mika-avatar-input maxlength="160" placeholder="輸入練習內容..." autocomplete="off" />
            <button type="submit">送出</button>
        </form>
    </div>
</aside>
