@model LearnMore.Services.ManagedUserDetail
@{
    ViewData["Title"] = "使用者詳情";
    var user = Model.User;
    var state = user.DeletedAt.HasValue ? "已刪除（保留歷史）" : user.IsDisabled ? "已停用" : "使用中";
    string Stamp(DateTime? time) => time?.ToString("yyyy-MM-dd HH:mm:ss") ?? "尚無紀錄";
    string ActionName(string action) => action switch { "disable" => "停用", "enable" => "重新啟用", "delete" => "刪除（保留歷史）", _ => action };
}
@section Styles {
    <link rel="stylesheet" href="~/css/management-queues.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/manager-users.css" asp-append-version="true" />
}
<section class="mq-page um-page" aria-labelledby="userTitle">
    <header class="mq-hero"><div><p class="mq-eyebrow">使用者檔案 · ID @user.Id</p><h1 id="userTitle">@(string.IsNullOrWhiteSpace(user.NickName) ? user.Name : user.NickName)</h1><p class="mq-subtitle um-email">@user.Email</p></div><a class="mq-link" asp-action="Index">返回使用者清單 ↗</a></header>
    <div class="um-grid">
        <article class="mq-card"><h2>帳號資料</h2><dl class="um-details">
            <dt>姓名</dt><dd>@user.Name</dd><dt>暱稱</dt><dd>@(string.IsNullOrWhiteSpace(user.NickName) ? "尚未設定" : user.NickName)</dd>
            <dt>Email</dt><dd class="um-email">@user.Email</dd><dt>權限</dt><dd>@(user.Manager ? "Manager" : "一般會員")</dd><dt>狀態</dt><dd>@state</dd>
            <dt>建立時間</dt><dd>@Stamp(user.CreatedAt)（資料庫原始時間）</dd><dt>最後登入</dt><dd>@Stamp(user.LastLoginAt)（UTC）</dd><dt>刪除時間</dt><dd>@Stamp(user.DeletedAt)（UTC）</dd>
            <dt>App 登入方式</dt><dd>@(Model.Providers.Count == 0 ? "尚無 App 綁定紀錄" : string.Join("、", Model.Providers))</dd>
        </dl><p class="text-muted">最後登入不代表目前在線；未保存的舊登入時間不推估。本站不顯示登入憑證、權杖或密碼。</p></article>
        <article class="mq-card"><h2>使用情形</h2><div class="um-stats">
            @foreach (var item in Model.Activity) { <div><strong>@(item.Value?.ToString() ?? "無法取得")</strong><span>@item.Key</span></div> }
        </div><p class="text-muted">活動統計保留歷史；未建置的資料表不當成零筆。App 工作階段數不包含網站登入，也不代表在線人數。</p></article>
    </div>
    <article class="mq-card"><h2>管理操作</h2>
        @if (user.Manager || user.Email == Context.Session.GetString("Email")) { <p>為避免鎖住站務帳號，不提供對自己或 Manager 的停用／刪除操作。</p> }
        else if (user.DeletedAt.HasValue) { <p>此帳號已刪除，不再允許登入；歌曲、留言與操作紀錄仍保留，不會連帶刪除。</p> }
        else
        {
            <p>停用後，既有網站與 App 登入會在下一次請求失效。刪除為軟刪除，保留帳號識別與歷史，不能由此頁重新啟用，也不是個資永久清除。</p>
            <form method="post" asp-action="Change" asp-route-id="@user.Id" class="um-change">
                <input type="hidden" name="revision" value="@user.Revision" />
                <div><label for="accountAction">操作</label><select id="accountAction" name="action" class="form-select" required><option value="">請選擇操作</option><option value="@(user.IsDisabled ? "enable" : "disable")">@(user.IsDisabled ? "重新啟用" : "停用帳號")</option><option value="delete">刪除帳號（保留歷史）</option></select></div>
                <div><label for="confirmation">輸入此帳號完整 Email 確認</label><input id="confirmation" name="confirmation" class="form-control" required autocomplete="off" maxlength="320" /></div>
                <div><label for="reason">操作原因（會記錄）</label><textarea id="reason" name="reason" class="form-control" required maxlength="500" rows="3"></textarea></div>
                <button type="submit" class="btn btn-outline-danger">確認執行</button>
            </form>
        }
    </article>
    <article class="mq-card"><h2>最近 50 筆管理紀錄</h2>
        @if (Model.Events.Count == 0) { <p>尚無管理操作紀錄。</p> }
        @foreach (var entry in Model.Events) { <div class="um-event"><strong>@ActionName(entry.Action)</strong><small>@Stamp(entry.CreatedAt) UTC · 操作者 ID @entry.ActorUserId</small><p>@entry.Reason</p></div> }
    </article>
</section>
