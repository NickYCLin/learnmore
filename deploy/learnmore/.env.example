# 複製到部署目錄（例：/data/yangchen/learnmore-deploy/.env），chmod 600，不要 commit。
LEARNMORE_STORAGE_ROOT=/data/yangchen/learnmore-deploy
MSSQL_SA_PASSWORD=
# 預設用 sa；還原舊庫後可改用 magicplus 等應用帳號
LEARNMORE_DB_NAME=language
LEARNMORE_DB_USER=sa
LEARNMORE_DB_PASSWORD=
SQL_HOST_PORT=14334
WEB_HOST_PORT=18090
# cookies 放在 ${LEARNMORE_STORAGE_ROOT}/web/cookies/ 底下，例：/var/lib/learnmore/cookies/youtube.txt
YTDLP_COOKIES_PATH=
HIGH_ACCURACY_REMOTE_ENABLED=false
LEARNMORE_API_BASE_URL=http://learnmore-api:8080
LEARNMORE_API_TOKEN=
# Express（免費、正式可用、單庫 10GB 上限）或 Developer（僅限開發測試）
MSSQL_PID=Express
MSSQL_COLLATION=Chinese_Taiwan_Stroke_CI_AS
